From 63d0a6c9cb1fddf8551e5f67cd45d0f1b1ac3e41 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 27 Oct 2026 04:03:40 +0000
Subject: [PATCH 2/4] Fix keys lost when typing fast

A press that arrived while the 100 ms highlight timer was pending only set
m_stillActive and returned without sending the key, so double letters
('ll', 'rr') and any key tapped within 100 ms of the previous release were
dropped ('llama' -> 'lm', 'perro' -> 'pr').

Now every press sends its key; the highlight uses a member single-shot
QTimer that is stopped on press and restarted on release. Also remove the
unused 'width'/'height' members, which shadowed QWidget::width() and
QWidget::height().
---
 widget.cpp | 38 +++++++++++++++-----------------------
 widget.h   |  6 ++----
 2 files changed, 17 insertions(+), 27 deletions(-)

diff --git a/widget.cpp b/widget.cpp
index 790103e..dff71f7 100644
--- a/widget.cpp
+++ b/widget.cpp
@@ -1,9 +1,8 @@
 #include "widget.h"
 #include "./ui_widget.h"
-#include <QKeyEvent>
+#include <QMouseEvent>
 #include <QDebug>
 #include <QPainter>
-#include <QTimer>
 Widget::Widget(QWidget *parent)
     : QWidget(parent)
     , ui(new Ui::Widget)
@@ -18,6 +17,10 @@ Widget::Widget(QWidget *parent)
     auto geom = ui->closeBtn->geometry();
     ui->closeBtn->setGeometry(bounds.width() / 2 - geom.width() / 2, bounds.height() + verticalSpace / 2 - geom.height() / 2, geom.width(), geom.height());
     QObject::connect(ui->closeBtn, SIGNAL(clicked()), this, SLOT(exitSlot()));
+
+    m_highlightTimer.setSingleShot(true);
+    m_highlightTimer.setInterval(100);
+    connect(&m_highlightTimer, &QTimer::timeout, this, &Widget::disableCurrentKey);
 }
 void Widget::mousePressEvent(QMouseEvent *event)
 {
@@ -25,35 +28,24 @@ void Widget::mousePressEvent(QMouseEvent *event)
     QPoint pos = event->pos();
     auto key = m_keyboard.getPressedKey(pos);
     if (key == std::nullopt) return;
-    if (!m_enabledTimer)
-    {
-        auto [keyIndex, name] = key.value();
-        m_vkeyboard.sendKey(name);
-        m_currKeyPressed = keyIndex;
-        m_keyboard.enableKey(keyIndex);
-        repaint();
-        return;
-    }
-    m_stillActive = true;
+    // Every press is sent, even if the previous key is still highlighted:
+    // the highlight is only visual feedback and must not block typing.
+    m_highlightTimer.stop();
+    m_keyboard.disableKey(m_currKeyPressed);
+    auto [keyIndex, name] = key.value();
+    m_vkeyboard.sendKey(name);
+    m_currKeyPressed = keyIndex;
+    m_keyboard.enableKey(keyIndex);
+    repaint();
 }
 void Widget::mouseReleaseEvent(QMouseEvent *event)
 {
     if (event->button() != Qt::MouseButton::LeftButton) return;
     if (m_currKeyPressed < 0) return;
-    m_stillActive = false;
-    if (!m_enabledTimer)
-    {
-        QTimer::singleShot(100, this, &Widget::disableCurrentKey);
-        m_enabledTimer = true;
-    }
+    m_highlightTimer.start();   // (re)starts the 100 ms countdown
 }
 void Widget::disableCurrentKey()
 {
-    m_enabledTimer = false;
-    if (m_stillActive)
-    {
-        return;
-    }
     m_keyboard.disableKey(m_currKeyPressed);
     m_currKeyPressed = -1;
     repaint();
diff --git a/widget.h b/widget.h
index 8f0f92a..ab5fdad 100644
--- a/widget.h
+++ b/widget.h
@@ -1,6 +1,7 @@
 #ifndef WIDGET_H
 #define WIDGET_H
 #include <QWidget>
+#include <QTimer>
 #include "uinputvkeyboard.h"
 #include "x11vkeyboard.h"
 #include "keyboard.h"
@@ -25,11 +26,8 @@ private:
     void disableCurrentKey();
     keyboard m_keyboard;
     x11vkeyboard m_vkeyboard;
-    bool m_enabledTimer {false};
-    bool m_stillActive  {false};
+    QTimer m_highlightTimer;      // turns the highlight off 100 ms after release
     int m_currKeyPressed {-1};
-    const int width {520};
-    const int height {256};
 
     Ui::Widget *ui;
 private slots:
-- 
