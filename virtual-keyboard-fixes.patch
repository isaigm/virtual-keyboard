From cafea578dccffc5c42abb4449ebc23c1e2ce30a5 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 27 Oct 2026 04:05:15 +0000
Subject: [PATCH 3/4] Lay out keys by QWERTY rows and stop clipping key
 outlines
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

NAMES was the three QWERTY rows concatenated, but it was cut into a
uniform 9-key grid, so 'p' ended up on the middle row and 'l', 'ñ' on the
bottom row. It also relied on NAMES.size() being divisible by totalRows:
any leftover keys got an empty rectangle and were invisible/unclickable.

Keys are now defined per row (rows may differ in length, shorter rows are
centered). An 8 px padding keeps the outlines of the first/last row and
column from being cut by the window edge. Index checks in
enableKey/disableKey no longer compare int with size_t.
---
 keyboard.cpp | 49 +++++++++++++++++++++++--------------------------
 keyboard.h   | 12 ++++++++----
 2 files changed, 31 insertions(+), 30 deletions(-)

diff --git a/keyboard.cpp b/keyboard.cpp
index b603ba1..13aacca 100644
--- a/keyboard.cpp
+++ b/keyboard.cpp
@@ -1,38 +1,35 @@
 #include "keyboard.h"
+#include <algorithm>
 #include <QDebug>
-keyboard::keyboard() : m_keys(NAMES.size()) {
-    for(size_t i = 0; i < NAMES.size(); i++)
+keyboard::keyboard()
+{
+    // The widest row sets the keyboard width; shorter rows are centered.
+    int maxKeys = 0;
+    for (const QString &row : ROWS)
     {
-        auto &key = m_keys[i];
-        key.setName(NAMES.at(i));
+        maxKeys = std::max(maxKeys, int(row.size()));
     }
-    int keysPerCol = NAMES.size() / totalRows;
-    float xmargin = 8.0f;
-    float ymargin = 32.0f;
-    float mx = 0.0f;
-    float my = 0.0f;
-    float topleftx = mx;
-    float toplefty = my;
-    float bottomrightx = topleftx + (keysPerCol - 1) * (xmargin + kWidth) + kWidth;
-    float bottomrighty = toplefty + (totalRows - 1) * (ymargin + kHeight) + kHeight;
-    for (int i = 0; i < totalRows; i++)
+    float maxRowWidth = maxKeys * kWidth + (maxKeys - 1) * xmargin;
+
+    for (int i = 0; i < ROWS.size(); i++)
     {
-        for (int j = 0; j < keysPerCol; j++)
+        const QString &row = ROWS.at(i);
+        float rowWidth = row.size() * kWidth + (row.size() - 1) * xmargin;
+        float x0 = padding + (maxRowWidth - rowWidth) / 2.0f;
+        float y  = padding + i * (kHeight + ymargin);
+        for (int j = 0; j < row.size(); j++)
         {
-            QRectF bounds;
-            QPointF pos(mx + j * (xmargin + kWidth), my + i * (ymargin + kHeight));
-            bounds.setTopLeft(pos);
-            bounds.setWidth(kWidth);
-            bounds.setHeight(kHeight);
-            m_keys[j + i * keysPerCol].setBounds(bounds);
+            ckey key(row.at(j));
+            key.setBounds(QRectF(x0 + j * (kWidth + xmargin), y, kWidth, kHeight));
+            m_keys.push_back(key);
         }
     }
-    m_bounds.setTopLeft({topleftx, toplefty});
-    m_bounds.setBottomRight({bottomrightx, bottomrighty});
+    float totalHeight = ROWS.size() * kHeight + (ROWS.size() - 1) * ymargin;
+    m_bounds = QRectF(0.0f, 0.0f, maxRowWidth + 2 * padding, totalHeight + 2 * padding);
 }
 void keyboard::enableKey(int index)
 {
-    if (index < m_keys.size() && index >= 0)
+    if (index >= 0 && index < int(m_keys.size()))
     {
         m_keys[index].setClicked(true);
     }
@@ -40,7 +37,7 @@ void keyboard::enableKey(int index)
 
 void keyboard::disableKey(int index)
 {
-    if (index < m_keys.size() && index >= 0)
+    if (index >= 0 && index < int(m_keys.size()))
     {
         m_keys[index].setClicked(false);
     }
@@ -55,7 +52,7 @@ void keyboard::render(QPainter &painter)
 }
 std::optional<keyboard::key_t> keyboard::getPressedKey(QPointF point)
 {
-    for (int i = 0; i < m_keys.size(); i++)
+    for (int i = 0; i < int(m_keys.size()); i++)
     {
         auto &key = m_keys[i];
         if (key.contains(point)) return std::make_optional(keyboard::key_t{i, key.getName()});
diff --git a/keyboard.h b/keyboard.h
index 5c2539f..da3c1b7 100644
--- a/keyboard.h
+++ b/keyboard.h
@@ -2,6 +2,7 @@
 #define KEYBOARD_H
 #include <vector>
 #include <QString>
+#include <QStringList>
 #include <optional>
 #include "ckey.h"
 class keyboard
@@ -21,10 +22,13 @@ public:
     void render(QPainter &painter);
 private:
     QRectF m_bounds;
-    const QString NAMES = "qwertyuiopasdfghjklñzxcvbnm";
-    const int kWidth = 64;
-    const int kHeight = 64;
-    const int totalRows = 3;
+    // One string per row, in QWERTY order. Rows may have different lengths.
+    const QStringList ROWS = {"qwertyuiop", "asdfghjklñ", "zxcvbnm"};
+    const float kWidth  = 64.0f;
+    const float kHeight = 64.0f;
+    const float xmargin = 8.0f;    // horizontal gap between keys
+    const float ymargin = 32.0f;   // vertical gap between rows
+    const float padding = 8.0f;    // empty border so key outlines are not clipped
     std::vector<ckey> m_keys;
 };
 #endif // KEYBOARD_H
-- 
