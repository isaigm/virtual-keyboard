From 306a62dcedaba35628438024de00b97aa07a0dea Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 27 Oct 2026 04:03:00 +0000
Subject: [PATCH 1/4] Fix linking: use target_link_libraries for
 X11/Xtst/X11Extras

The X11 libraries were passed as -l flags inside CMAKE_CXX_FLAGS. Those
flags land before the object files on the link line, so with --as-needed
(default on Debian/Ubuntu) the link fails with 'undefined reference to
XSync'. Also drop the Qt 6 branch: it only compiled main/widget (missing
keyboard.cpp, ckey.cpp, ...) and X11Extras does not exist in Qt 6.
Ignore Qt Creator's per-user CMakeLists.txt.user.
---
 .gitignore     |  2 +-
 CMakeLists.txt | 82 ++++++++++++++------------------------------------
 2 files changed, 24 insertions(+), 60 deletions(-)

diff --git a/.gitignore b/.gitignore
index dc84959..0ff047c 100644
--- a/.gitignore
+++ b/.gitignore
@@ -1,2 +1,2 @@
 build/
-
+CMakeLists.txt.user
diff --git a/CMakeLists.txt b/CMakeLists.txt
index 1d55bb8..b913ea2 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1,4 +1,4 @@
-cmake_minimum_required(VERSION 3.5)
+cmake_minimum_required(VERSION 3.16)
 
 project(virtual-keyboard VERSION 0.1 LANGUAGES CXX)
 
@@ -8,71 +8,35 @@ set(CMAKE_AUTORCC ON)
 
 set(CMAKE_CXX_STANDARD 20)
 set(CMAKE_CXX_STANDARD_REQUIRED ON)
-set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -g -lXtst -lX11 -lm -lQt5X11Extras")
 
-find_package(QT NAMES Qt6 Qt5 REQUIRED COMPONENTS Widgets   X11Extras )
-find_package(Qt${QT_VERSION_MAJOR} REQUIRED COMPONENTS Widgets   X11Extras )
-
-set(PROJECT_SOURCES
-        main.cpp
-        widget.cpp
-        widget.h
-        widget.ui
-)
-
-if(${QT_VERSION_MAJOR} GREATER_EQUAL 6)
-    qt_add_executable(virtual-keyboard
-        MANUAL_FINALIZATION
-        ${PROJECT_SOURCES}
-    )
-# Define target properties for Android with Qt 6 as:
-#    set_property(TARGET virtual-keyboard APPEND PROPERTY QT_ANDROID_PACKAGE_SOURCE_DIR
-#                 ${CMAKE_CURRENT_SOURCE_DIR}/android)
-# For more information, see https://doc.qt.io/qt-6/qt-add-executable.html#target-creation
-else()
-    if(ANDROID)
-        add_library(virtual-keyboard SHARED
-            ${PROJECT_SOURCES}
-        )
-# Define properties for Android with Qt 5 after find_package() calls as:
-#    set(ANDROID_PACKAGE_SOURCE_DIR "${CMAKE_CURRENT_SOURCE_DIR}/android")
-    else()
-        add_executable(virtual-keyboard
-            ${PROJECT_SOURCES}
-
-            keyboard.h keyboard.cpp
-            ckey.h ckey.cpp
-            virtualkeyboard.h virtualkeyboard.cpp
-            uinputvkeyboard.h uinputvkeyboard.cpp
-            x11vkeyboard.h x11vkeyboard.cpp
-
-        )
-    endif()
+# QX11Info (X11Extras) only exists in Qt 5, so this project is Qt 5 only.
+find_package(Qt5 REQUIRED COMPONENTS Widgets X11Extras)
+find_package(X11 REQUIRED)
+if(NOT X11_Xtst_FOUND)
+    message(FATAL_ERROR "libXtst not found (install libxtst-dev / libxtst)")
 endif()
 
-target_link_libraries(virtual-keyboard PRIVATE Qt${QT_VERSION_MAJOR}::Widgets)
+add_executable(virtual-keyboard
+    main.cpp
+    widget.cpp widget.h widget.ui
+    keyboard.cpp keyboard.h
+    ckey.cpp ckey.h
+    virtualkeyboard.cpp virtualkeyboard.h
+    uinputvkeyboard.cpp uinputvkeyboard.h
+    x11vkeyboard.cpp x11vkeyboard.h
+)
 
-# Qt for iOS sets MACOSX_BUNDLE_GUI_IDENTIFIER automatically since Qt 6.1.
-# If you are developing for iOS or macOS you should consider setting an
-# explicit, fixed bundle identifier manually though.
-if(${QT_VERSION} VERSION_LESS 6.1.0)
-  set(BUNDLE_ID_OPTION MACOSX_BUNDLE_GUI_IDENTIFIER com.example.virtual-keyboard)
-endif()
-set_target_properties(virtual-keyboard PROPERTIES
-    ${BUNDLE_ID_OPTION}
-    MACOSX_BUNDLE_BUNDLE_VERSION ${PROJECT_VERSION}
-    MACOSX_BUNDLE_SHORT_VERSION_STRING ${PROJECT_VERSION_MAJOR}.${PROJECT_VERSION_MINOR}
-    MACOSX_BUNDLE TRUE
-    WIN32_EXECUTABLE TRUE
+# Libraries go here, not in CMAKE_CXX_FLAGS: flags end up before the object
+# files on the link line, and with --as-needed (default on Debian/Ubuntu)
+# the linker drops them.
+target_link_libraries(virtual-keyboard PRIVATE
+    Qt5::Widgets
+    Qt5::X11Extras
+    X11::X11
+    X11::Xtst
 )
 
 include(GNUInstallDirs)
 install(TARGETS virtual-keyboard
-    BUNDLE DESTINATION .
-    LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
     RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR}
 )
-
-if(QT_VERSION_MAJOR EQUAL 6)
-    qt_finalize_executable(virtual-keyboard)
-endif()
-- 
