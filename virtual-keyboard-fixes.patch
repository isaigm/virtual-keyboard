From b448107c23ae02991e24e825194fc1cd4e10da18 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 27 Oct 2026 04:06:23 +0000
Subject: [PATCH 4/4] Harden keyboard backends

- x11vkeyboard: under a Wayland session Qt does not use X11 and
  QX11Info::display() returns nullptr; XTestFakeKeyEvent(nullptr, ...)
  segfaulted on the first key. Now it warns and returns.
- qcharToCode: replace assert + lookup with a single find(); sendKey
  ignores characters without a code instead of sending keycode -1.
- virtualkeyboard: add a virtual destructor (polymorphic base class).
- uinputvkeyboard: non-copyable (owns the fd; a copy would destroy the
  device twice), zero-initialise input_event and let the kernel set the
  timestamp.
---
 uinputvkeyboard.cpp | 13 ++++---------
 uinputvkeyboard.h   |  3 +++
 virtualkeyboard.h   |  1 +
 x11vkeyboard.cpp    | 30 ++++++++++++++++++++----------
 4 files changed, 28 insertions(+), 19 deletions(-)

diff --git a/uinputvkeyboard.cpp b/uinputvkeyboard.cpp
index ea2f78d..fc73193 100644
--- a/uinputvkeyboard.cpp
+++ b/uinputvkeyboard.cpp
@@ -86,27 +86,22 @@ uinputvkeyboard::uinputvkeyboard()
 }
 int uinputvkeyboard::qcharToCode(QChar ch)
 {
-    assert(m_tableCodes.contains(ch) == true);
-    if (m_tableCodes.contains(ch))
-    {
-        return m_tableCodes[ch];
-    }
-    return -1;
+    auto it = m_tableCodes.find(ch);
+    return it != m_tableCodes.end() ? it->second : -1;
 }
 
 void uinputvkeyboard::emitKey(int type, int code, int val)
 {
-    struct input_event ie;
+    struct input_event ie {};   // zeroed; the kernel fills in the timestamp
     ie.type = type;
     ie.code = code;
     ie.value = val;
-    ie.time.tv_sec = 0;
-    ie.time.tv_usec = 0;
     write(m_fd, &ie, sizeof(ie));
 }
 void uinputvkeyboard::sendKey(QChar key)
 {
     int code = qcharToCode(key);
+    if (code < 0) return;
     emitKey(EV_KEY, code, 1);
     emitKey(EV_SYN, SYN_REPORT, 0);
     emitKey(EV_KEY, code, 0);
diff --git a/uinputvkeyboard.h b/uinputvkeyboard.h
index 9487451..b76e44f 100644
--- a/uinputvkeyboard.h
+++ b/uinputvkeyboard.h
@@ -8,6 +8,9 @@ class uinputvkeyboard : public virtualkeyboard
 public:
     uinputvkeyboard();
     ~uinputvkeyboard();
+    // Owns a file descriptor: a copy would close/destroy the device twice.
+    uinputvkeyboard(const uinputvkeyboard &) = delete;
+    uinputvkeyboard &operator=(const uinputvkeyboard &) = delete;
     virtual void sendKey(QChar key);
     virtual int qcharToCode(QChar ch);
 private:
diff --git a/virtualkeyboard.h b/virtualkeyboard.h
index e2ca741..5d01053 100644
--- a/virtualkeyboard.h
+++ b/virtualkeyboard.h
@@ -5,6 +5,7 @@ class virtualkeyboard
 {
 public:
     virtualkeyboard();
+    virtual ~virtualkeyboard() = default;
     virtual int qcharToCode(QChar ch) = 0;
     virtual void sendKey(QChar key) = 0;
 };
diff --git a/x11vkeyboard.cpp b/x11vkeyboard.cpp
index 3d79da0..7884e5d 100644
--- a/x11vkeyboard.cpp
+++ b/x11vkeyboard.cpp
@@ -1,4 +1,5 @@
 #include "x11vkeyboard.h"
+#include <QDebug>   // Qt headers must come before X11 ones (Bool/Status macros)
 #include <QtX11Extras/qx11info_x11.h>
 #include <X11/Xlib.h>
 #include <X11/keysym.h>
@@ -37,18 +38,27 @@ x11vkeyboard::x11vkeyboard()
 void x11vkeyboard::sendKey(QChar key)
 {
     int code = qcharToCode(key);
-    XTestFakeKeyEvent(QX11Info::display(), code, true, 0);
-    XSync(QX11Info::display(), False);
-    XTestFakeKeyEvent(QX11Info::display(), code, false, 0);
-    XSync(QX11Info::display(), False);
+    if (code < 0)
+    {
+        qWarning() << "x11vkeyboard: no keycode for" << key;
+        return;
+    }
+    // Under Wayland Qt does not use X11 and display() is nullptr;
+    // passing it to XTest would segfault.
+    Display *dpy = QX11Info::display();
+    if (dpy == nullptr)
+    {
+        qWarning("x11vkeyboard: not running on X11 (Wayland session?), key not sent");
+        return;
+    }
+    XTestFakeKeyEvent(dpy, code, True, 0);
+    XSync(dpy, False);
+    XTestFakeKeyEvent(dpy, code, False, 0);
+    XSync(dpy, False);
 }
 int x11vkeyboard::qcharToCode(QChar ch)
 {
-    assert(m_tableCodes.contains(ch) == true);
-    if (m_tableCodes.contains(ch))
-    {
-        return m_tableCodes[ch];
-    }
-    return -1;
+    auto it = m_tableCodes.find(ch);
+    return it != m_tableCodes.end() ? it->second : -1;
 }
 
-- 
2.43.0

